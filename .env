# Salin file ini menjadi .env lalu isi nilainya.

# WAJIB: kata sandi untuk masuk ke panel admin (/admin). Pakai yang panjang dan unik.
ADMIN_PASSWORD=SMANLAN110

# Port server (banyak hosting mengisinya otomatis).
PORT=1

# Folder penyimpanan data. Di hosting, arahkan ke disk/volume permanen (mis. /var/data).
DATA_DIR=./data

# Isi 1 jika website berjalan di belakang proxy hosting (Render, Railway, Nginx, Cloudflare).
# Dipakai agar pembatas kiriman membaca IP pengunjung yang benar.
TRUST_PROXY=1
